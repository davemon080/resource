rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Progress Validation
    function isValidUserProgress(data) {
      return data.keys().hasAll(['uid', 'unlockedModuleIndex']) &&
             data.uid == request.auth.uid &&
             data.unlockedModuleIndex is int &&
             data.unlockedModuleIndex >= 0 &&
             (!('completed' in data) || data.completed is bool) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100));
    }

    // Modules: Read-only for students, write only for admins (not implemented yet, so false)
    match /modules/{moduleId} {
      allow read: if isSignedIn() && isValidId(moduleId);
      allow write: if false;
    }

    // Users: Owner can read/write their own progress
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId) && isValidId(userId); // list on self is okay if filtered
      
      allow create: if isOwner(userId) && isValidUserProgress(incoming());
      
      allow update: if isOwner(userId) && 
                      isValidUserProgress(incoming()) && (
                        // Action: Progress Update
                        (incoming().diff(existing()).affectedKeys().hasOnly(['unlockedModuleIndex', 'completed', 'completedAt', 'displayName', 'email']))
                      );
    }
  }
}
